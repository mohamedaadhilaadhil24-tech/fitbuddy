# FitBuddy configuration - copy this file to .env and fill in your values
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini models (must be available to your API key)
# Free tier: Flash-class models. Pro models require billing.
WORKOUT_MODEL=gemini-flash-latest
TIP_MODEL=gemini-flash-latest
# Comma-separated fallback chain used when the primary model is rate-limited
FALLBACK_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest
